{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Create venv",
      "type": "shell",
      "command": "python3 -m venv .venv"
    },
    {
      "label": "Install deps",
      "type": "shell",
      "command": ". .venv/bin/activate && python3 -m pip install -U pip && python3 -m pip install -r requirements.txt && python3 -m pip install -r requirements-dev.txt"
    },
    {
      "label": "Test",
      "type": "shell",
      "command": ". .venv/bin/activate && pytest -q"
    },
    {
      "label": "Run Phase Surface (CPU smoke)",
      "type": "shell",
      "command": ". .venv/bin/activate && python3 -m scripts.run_phase_surface_v1 --model gpt2 --device cpu --seed 0 --H 64 --tau 0.90 --trials 50 --out out/phase_surface_v1_smoke"
    }
  ]
}
